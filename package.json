{
  "name": "dsh-opticforge",
  "version": "0.2.1",
  "description": "OpticForge —— 光电工程师知识库，DeepSeek Harness 插件。40 个板块、324 条带来源的事实条目，覆盖基础理论、工程系统、前沿方向与场景深化（几何光学、物理光学、光学检测、光学设计、高光谱推扫/快照、Czerny-Turner 与 Offner 分光系统）；BM25 检索 + 板块目录 + 单条取用，纯 Node.js，零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "data/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "verify": "node scripts/verify-all.mjs",
    "kb": "node scripts/build-kb.mjs --all",
    "kb:check": "node scripts/build-kb.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "optics",
    "optical-engineering",
    "knowledge-base",
    "bm25",
    "confocal",
    "tolerancing",
    "metasurface",
    "hyperspectral",
    "photonics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBMGGGG/dsh-opticforge.git"
  },
  "homepage": "https://github.com/WBMGGGG/dsh-opticforge#readme",
  "bugs": {
    "url": "https://github.com/WBMGGGG/dsh-opticforge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
