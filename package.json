{
  "name": "dsh-opticforge",
  "version": "1.1.0",
  "description": "OpticForge —— 光电工程师任务辅助插件，DeepSeek Harness。任务受理与能力路由（Skill / MCP / 本地工具 / 定向检索）+ 40 个板块、324 条带来源的事实条目 + 交付自检。输入一个具体问题，输出简报、知识证据、分阶段计划、检索包与验收清单；纯 Node.js，零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "data/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "verify": "node scripts/verify-all.mjs",
    "kb": "node scripts/build-kb.mjs --all",
    "kb:check": "node scripts/build-kb.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "optics",
    "optical-engineering",
    "knowledge-base",
    "task-assistant",
    "capability-routing",
    "workflow",
    "bm25",
    "confocal",
    "tolerancing",
    "metasurface",
    "hyperspectral",
    "photonics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBMGGGG/dsh-opticforge.git"
  },
  "homepage": "https://github.com/WBMGGGG/dsh-opticforge#readme",
  "bugs": {
    "url": "https://github.com/WBMGGGG/dsh-opticforge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
