{
  "name": "dsh-opticforge",
  "version": "3.1.0",
  "description": "OpticForge —— 光电工程师任务辅助插件，DeepSeek Harness。KB-first 任务受理与能力路由 + 40 个板块、324 条事实条目 + 16 张主题卡、308 张概念卡、6 个通用维度 + 19 张公式卡 + 交叉覆盖与采信闸门。输入一个具体问题，多剧本激活、按维度取证，再按 web_gate 三断点决定是否联网；纯 Node.js，零运行时依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "data/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs && node test/assist-contract.test.mjs && node test/entry-contract.test.mjs",
    "verify": "node scripts/verify-all.mjs",
    "kb": "node scripts/build-kb.mjs --all",
    "kb:check": "node scripts/build-kb.mjs --check",
    "eval:kb-first": "node eval/run-kb-first.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "optics",
    "optical-engineering",
    "knowledge-base",
    "task-assistant",
    "capability-routing",
    "workflow",
    "bm25",
    "confocal",
    "tolerancing",
    "metasurface",
    "hyperspectral",
    "photonics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBMGGGG/dsh-opticforge.git"
  },
  "homepage": "https://github.com/WBMGGGG/dsh-opticforge#readme",
  "bugs": {
    "url": "https://github.com/WBMGGGG/dsh-opticforge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
