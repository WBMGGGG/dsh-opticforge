  {
    "id": "thin_lens_gaussian",
    "title": "薄透镜高斯成像与放大率",
    "domains": ["optical_design", "testing_alignment", "generic"],
    "keywords": ["薄透镜", "焦距", "物距", "像距", "放大率", "成像"],
    "formula": "1/f = 1/l' - 1/l；β = l'/l",
    "variables": [
      { "symbol": "f", "unit": "mm", "meaning": "焦距" },
      { "symbol": "l", "unit": "mm", "meaning": "物距，按所选符号约定带符号" },
      { "symbol": "l'", "unit": "mm", "meaning": "像距，按所选符号约定带符号" },
      { "symbol": "β", "unit": "1", "meaning": "横向放大率" }
    ],
    "assumptions": ["近轴小孔径", "薄透镜或已归算到主平面的厚透镜", "全计算只使用一种符号约定"],
    "sanity_range": "会聚薄透镜 f>0；实像与虚像的符号必须符合所选约定；不得把后焦距当焦距。",
    "worked_example": "f=50 mm、l=-200 mm：1/l'=1/f+1/l=0.015 mm^-1，所以 l'=66.67 mm，β=-0.3333。",
    "source_chunk_ids": ["F01-01"]
  },
  {
